{%- set run_command -%}
{% if include_http_runtime -%}
uv run python -m {{ package_name }} http --reload
{% elif include_stream_runtime and include_redis_integration -%}
uv run python -m {{ package_name }} stream
{% else -%}
uv run python -m {{ package_name }}
{% endif -%}
{%- endset -%}
# Install dependencies.
install:
    uv sync --extra dev

# Run the service.
run: install
    {{ run_command | trim }}
{% if include_tests %}
# Run the test suite.
test: install
    uv run pytest
{% endif %}{% if include_pre_commit %}
# Install pre-commit hooks.
hooks: install
    uv run pre-commit install

# Run pre-commit against all files.
pre-commit: install
    uv run pre-commit run --all-files
{% endif %}{% if include_postgresql_integration %}
# Apply all pending migrations.
migrate:
    uv run alembic upgrade head

# Downgrade migrations by N steps (default 1).
downgrade revision="-1":
    uv run alembic downgrade {% raw %}{{ revision }}{% endraw %}

# Create a new empty revision, e.g. `just revision "add_users_table"`.
revision message:
    uv run alembic revision -m "{% raw %}{{ message }}{% endraw %}"

# Create a new autogenerated revision from model changes.
revision-autogenerate message:
    uv run alembic revision --autogenerate -m "{% raw %}{{ message }}{% endraw %}"

# Show the current revision.
current:
    uv run alembic current

# Show migration history.
history:
    uv run alembic history
{% endif %}
